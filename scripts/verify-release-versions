#!/bin/sh
# SPDX-License-Identifier: Apache-2.0 OR MIT
#
# Fails when a version-bearing file disagrees with the project version in
# CMakeLists.txt (the single source of truth). Run by `make check` and CI.
# Usage: scripts/verify-release-versions [expected-version]
set -eu
cd "$(dirname "$0")/.."

version=$(sed -n 's/^project(pain001_sdk VERSION \([0-9.]*\) .*/\1/p' CMakeLists.txt)
if [ -z "$version" ]; then
  echo "verify-release-versions: no version in CMakeLists.txt" >&2
  exit 1
fi
if [ $# -gt 0 ] && [ "$1" != "$version" ]; then
  echo "verify-release-versions: CMakeLists.txt says $version, expected $1" >&2
  exit 1
fi

status=0
# expect FILE FIXED-STRING: FILE must contain FIXED-STRING.
expect() {
  if ! grep -qF -- "$2" "$1"; then
    echo "$1: missing '$2'" >&2
    status=1
  fi
}

expect include/pain001/client.hpp "kSdkVersion = \"$version\""
expect CITATION.cff "version: \"$version\""
expect SECURITY.md "| \`$version\` (latest) |"
expect README.md "GIT_TAG        v$version)"
expect KEYS.asc "git verify-tag v$version"
expect .github/ISSUE_TEMPLATE/bug_report.yml "placeholder: \"$version\""
expect tests/package/CMakeLists.txt "find_package(pain001_sdk $version CONFIG REQUIRED)"
# The release prep renames Unreleased to the version; either is current.
if ! grep -qE "^## \[(Unreleased|$version)\]" CHANGELOG.md; then
  echo "CHANGELOG.md: no '## [Unreleased]' or '## [$version]' heading" >&2
  status=1
fi

if [ "$status" -eq 0 ]; then
  echo "verify-release-versions: every file says $version"
fi
exit "$status"
