#
# Package config for find_package(pain001_sdk CONFIG): defines the
# imported target pain001::sdk and finds what it links (nlohmann/json,
# installed with it, and the system libcurl).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json 3.12)
find_dependency(CURL)

include("${CMAKE_CURRENT_LIST_DIR}/pain001_sdkTargets.cmake")
check_required_components(pain001_sdk)
