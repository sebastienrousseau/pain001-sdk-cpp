# SPDX-License-Identifier: Apache-2.0 OR MIT
#
# The complexity ceilings from ~/Code/AGENTS.md section 0, per function:
# cognitive 15 (readability-function-cognitive-complexity), at most 60
# lines and 10 branches (readability-function-size; clang-tidy has no
# McCabe check, so the branch count stands in for cyclomatic). Plus the
# bug-finding and performance families. Every finding fails the gate.
Checks: >-
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  readability-function-cognitive-complexity,
  readability-function-size
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include/pain001|src|tests/support|fuzz)/[^/]+\.hpp$'
CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: 15
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true
  - key: readability-function-size.LineThreshold
    value: 60
  - key: readability-function-size.BranchThreshold
    value: 10
